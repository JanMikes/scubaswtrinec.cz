{% extends 'public/layout.html.twig' %}
{% set hero_image = 3 %}
{% block hero_eyebrow %}<p class="eyebrow mb-3 text-cyan-400">Ozvěte se nám</p>{% endblock %}
{% block page_title %}Kontakt{% endblock %}
{% block content %}
    <div class="grid gap-6">
        {% if contact and contact.text %}
            <article class="card p-6 sm:p-10"><div class="prose-dive">{{ contact.text|raw }}</div></article>
        {% endif %}
        <div class="grid gap-5 sm:grid-cols-2">
            {% for person in [
                {name: 'Roman Kudela', phone: '+420 723 007 349', email: 'kudela@email.cz'},
                {name: 'Martin Šajnar', phone: '+420 603 308 093', email: 'sajnar.martin@post.cz'},
            ] %}
                <div class="card p-6">
                    <p class="text-lg font-extrabold text-abyss-700">{{ person.name }}</p>
                    <p class="mt-3"><a class="font-semibold text-ocean-600 hover:text-abyss-600" href="tel:{{ person.phone|replace({' ': ''}) }}">{{ person.phone }}</a></p>
                    <p class="mt-1"><a class="font-semibold text-ocean-600 hover:text-abyss-600" href="mailto:{{ person.email }}">{{ person.email }}</a></p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
