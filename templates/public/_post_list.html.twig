{# News/article list (2014: 5 per page, date desc, 450-char teaser, "Číst více"). #}
<div class="space-y-6">
    {% for post in pager.items %}
        {% set url = path(detail_route, {id: post.id}) %}
        {% set cover = cover_photo(post) %}
        <article class="card group grid overflow-hidden {{ cover ? 'sm:grid-cols-[240px_minmax(0,1fr)]' : '' }}">
            {% if cover %}
                <a href="{{ url }}" class="block overflow-hidden" tabindex="-1" aria-hidden="true">
                    {% include 'partials/photo.html.twig' with {photo: cover, type: 'card', class: 'h-52 w-full transition duration-500 group-hover:scale-105 sm:h-full', alt: ''} only %}
                </a>
            {% endif %}
            <div class="p-6 sm:p-8">
                <time class="inline-flex items-center gap-2 rounded-full bg-ocean-50 px-3 py-1 text-xs font-bold text-ocean-700" datetime="{{ post.date ? post.date|date('Y-m-d') }}">
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                    {{ post.date ? post.date|date('d. m. Y') }}
                </time>
                <h2 class="mt-3 text-2xl font-extrabold leading-tight text-abyss-700"><a href="{{ url }}" class="hover:text-ocean-600">{{ post.name }}</a></h2>
                {% set teaser = post.text|excerpt %}
                {% if teaser %}<p class="mt-3 leading-7 text-slate-600">{{ teaser }}</p>{% endif %}
                <a href="{{ url }}" class="mt-5 inline-flex items-center gap-1 text-sm font-extrabold uppercase tracking-wider text-ocean-600 hover:text-abyss-600">Číst více <span aria-hidden="true">→</span></a>
            </div>
        </article>
    {% else %}
        <div class="card p-8 text-slate-600">Zatím zde nic není.</div>
    {% endfor %}
</div>
{% include 'partials/pagination.html.twig' %}
