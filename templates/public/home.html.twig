{% extends 'public/layout.html.twig' %}

{% block title %}{% endblock %}
{% block title_suffix %}SCUBASW — potápěčský klub Třinec{% endblock %}

{% block hero %}
<section class="relative isolate overflow-hidden" aria-label="Úvod">
    {% for i in 1..4 %}
        <img src="/images/slides/big/{{ i }}.jpg" alt="" data-slide {{ i > 1 ? 'loading="lazy"' : 'fetchpriority="high"' }}
             class="absolute inset-0 -z-20 h-full w-full animate-kenburns object-cover transition-opacity duration-[2000ms] {{ i == 1 ? 'opacity-100' : 'opacity-0' }}">
    {% endfor %}
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-abyss-950/90 via-abyss-800/55 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-64" aria-hidden="true">
        {% for b in [[12, 0], [22, 2.5], [35, 5], [61, 1.2], [74, 3.8], [86, 6.3]] %}
            <span class="absolute bottom-0 block animate-rise rounded-full border border-white/50 bg-white/10" style="left: {{ b[0] }}%; width: {{ 8 + loop.index * 2 }}px; height: {{ 8 + loop.index * 2 }}px; animation-delay: {{ b[1] }}s"></span>
        {% endfor %}
    </div>
    <div class="mx-auto max-w-7xl px-4 pb-32 pt-20 sm:px-6 sm:pb-40 sm:pt-28 lg:pt-36">
        <p class="eyebrow text-cyan-400">Potápěčský klub · Třinec · od roku 1986</p>
        <h1 class="mt-4 max-w-3xl font-display text-4xl font-black uppercase leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl">
            Pod hladinou<br><span class="text-cyan-400">jsme doma</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-ocean-50/90">SCUBA S.W. Třinec — potápění všeho druhu, výpravy, kurzy a dobrý kolektiv. Přidejte se k nám.</p>
        <div class="mt-9 flex flex-wrap gap-3">
            <a href="#aktuality" class="btn-cyan">Aktuality</a>
            <a href="{{ path('instructors') }}" class="btn-ghost">Naši instruktoři</a>
            <a href="{{ path('contact') }}" class="btn-ghost">Kontakt</a>
        </div>
    </div>
    {% include 'partials/wave.html.twig' %}
</section>
{% endblock %}

{% block main_offset %}pt-6{% endblock %}

{% block layout_content %}
    {% include 'partials/flashes.html.twig' %}
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
        <section id="aktuality" class="min-w-0 scroll-mt-24">
            <div class="mb-6 flex items-end justify-between gap-4">
                <h2 class="page-title !text-3xl sm:!text-4xl">Aktuality</h2>
                {% if pager.page > 1 %}<span class="text-sm font-semibold text-white/80">strana {{ pager.page }} z {{ pager.pageCount }}</span>{% endif %}
            </div>
            {% include 'public/_post_list.html.twig' with {detail_route: 'actuality_detail'} %}
        </section>
        <aside class="space-y-6">
            <section class="card overflow-hidden">
                <div class="bg-gradient-to-br from-abyss-600 to-ocean-500 p-6 text-white">
                    <h2 class="eyebrow text-cyan-400">O klubu</h2>
                    <p class="mt-3 font-display text-2xl font-extrabold uppercase leading-tight">Klub založen v roce 1986</p>
                    <p class="mt-3 text-sm leading-6 text-ocean-50/90">Potápění všeho druhu. Stálá členská základna. Dobrý kolektiv. Trénink dle rozpisu.</p>
                    <a href="{{ path('contact') }}" class="btn-light mt-5">Chci se přidat</a>
                </div>
            </section>
            <section class="card p-6">
                <h2 class="eyebrow text-ocean-600">Poslední galerie</h2>
                <div class="mt-4 grid grid-cols-3 gap-2">
                    {% for g in recent_galleries(6) %}
                        <a href="{{ path('gallery_detail', {id: g.id}) }}" class="group relative block overflow-hidden rounded-xl" title="{{ g.name }}">
                            {% include 'partials/photo.html.twig' with {photo: cover_photo(g), type: 'admin', class: 'aspect-square w-full transition group-hover:scale-110', alt: g.name} only %}
                        </a>
                    {% endfor %}
                </div>
                <a href="{{ path('galleries') }}" class="mt-4 inline-block text-sm font-extrabold uppercase tracking-wider text-ocean-600 hover:text-abyss-600">Všechny galerie →</a>
            </section>
            <section class="card p-6">
                <h2 class="eyebrow text-ocean-600">Diskuze</h2>
                <p class="mt-3 text-sm leading-6 text-slate-600">Máte dotaz k potápění, výpravám nebo klubu? Napište nám do diskuze.</p>
                <a href="{{ path('discussion') }}" class="btn-primary mt-4">Do diskuze</a>
            </section>
        </aside>
    </div>
{% endblock %}
