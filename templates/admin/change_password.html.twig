{% extends 'admin/layout.html.twig' %}
{% form_theme form 'admin/_form_theme.html.twig' %}
{% block admin_title %}Změna hesla{% endblock %}
{% block content %}
    <h1 class="font-display text-3xl font-extrabold text-abyss-800">Změna hesla</h1>
    {{ form_start(form, {attr: {class: 'card mt-6 grid grid-cols-[minmax(0,1fr)] max-w-xl gap-5 !rounded-2xl p-6 sm:p-8', novalidate: 'novalidate'}}) }}
        {{ form_rest(form) }}
        <div><button type="submit" class="btn-primary">Změnit heslo</button></div>
    {{ form_end(form) }}
{% endblock %}
