{% extends 'admin/layout.html.twig' %}
{% import 'admin/_macros.html.twig' as m %}
{% block admin_title %}{{ section.title }}{% endblock %}
{% block content %}
    {{ m.list_header(section, parent, inactive_count) }}
    <div class="card overflow-x-auto !rounded-2xl">
        <table class="adm-table">
            <thead><tr><th>Název</th><th>Odkaz</th><th class="text-right">Akce</th></tr></thead>
            <tbody>
            {% for row in rows %}
                <tr id="r{{ row.id }}" class="{{ row.active ? '' : 'opacity-60' }}">
                    <td class="font-semibold text-abyss-800">{{ row.name }}</td>
                    <td><a href="{{ row.url }}" target="_blank" rel="noopener" class="text-ocean-600 hover:underline">{{ row.url }}</a></td>
                    <td>{{ m.row_actions(section, row, loop, parent) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="text-slate-500">Prozatím nebyly přidány žádné záznamy.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
