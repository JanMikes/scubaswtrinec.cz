{% extends 'admin/layout.html.twig' %}
{% import 'admin/_macros.html.twig' as m %}
{% block admin_title %}{{ section.title }}{% endblock %}
{% block content %}
    {{ m.list_header(section, parent, inactive_count) }}
    <div class="card overflow-x-auto !rounded-2xl">
        <table class="adm-table">
            <thead><tr><th class="w-32">Datum</th><th>Nadpis</th><th class="w-40">Fotografie</th><th class="text-right">Akce</th></tr></thead>
            <tbody>
            {% for row in rows %}
                <tr id="r{{ row.id }}" class="{{ row.active ? '' : 'opacity-60' }}">
                    <td class="whitespace-nowrap text-slate-500">{{ row.date ? row.date|date('d. m. Y') }}</td>
                    <td class="font-semibold text-abyss-800">{{ row.name }}</td>
                    <td><a href="{{ path('admin_list', {section: section.photosSlug, (section.slug ~ 'Id'): row.id}) }}" class="adm-pill bg-slate-100 text-slate-700 hover:bg-slate-200">Fotografie ({{ row.photos|filter(p => not p.deleted)|length }})</a></td>
                    <td>{{ m.row_actions(section, row, loop, parent) }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-slate-500">Prozatím nebyly přidány žádné záznamy.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
