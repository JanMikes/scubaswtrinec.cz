{# Usage: include('partials/photo.html.twig', {photo: p, type: 'card', class: '...', alt: '...'}) #}
{% set url = photo_thumb(photo ?? null, type ?? 'card') %}
{% if url %}
    <img src="{{ url }}" alt="{{ alt ?? '' }}" loading="lazy" decoding="async" class="{{ class ?? '' }} object-cover">
{% else %}
    <div class="photo-placeholder {{ class ?? '' }}" role="img" aria-label="{{ alt ?? 'Fotografie' }}">
        <svg viewBox="0 0 64 64" class="h-1/3 max-h-16 w-auto opacity-80" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M10 40c6-5 12-5 18 0s12 5 18 0 8-4 8-4"/><path d="M10 50c6-5 12-5 18 0s12 5 18 0 8-4 8-4"/>
            <circle cx="44" cy="16" r="4"/><circle cx="34" cy="10" r="2.5"/><circle cx="50" cy="26" r="2"/>
        </svg>
    </div>
{% endif %}
