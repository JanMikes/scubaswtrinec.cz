# Committed defaults for local development. Production values come from the lily box
# (compose environment + Infisical-rendered .env, see TheDevs-cz/lily.srv apps/scubaswtrinec).
APP_ENV=dev
# Empty => derived from DATABASE_PASSWORD (see App\DependencyInjection\AppSecretEnvVarProcessor)
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=https://scubaswtrinec.cz

DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=scubaswtrinec
DATABASE_USER=root
DATABASE_PASSWORD=root


# Optional GA4 measurement id (empty = no analytics)
GA_MEASUREMENT_ID=
